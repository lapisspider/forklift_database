# Copy this file to ".env" and fill in your keys.
# The app runs as a plain database even if these are left blank —
# the AI web lookup and natural-language query features just stay disabled.

# Anthropic (Claude) — used for spec extraction and plain-English -> SQL.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Tavily — used to search the web and pull spec-sheet content.
# Get a key at https://tavily.com  (free tier available)
TAVILY_API_KEY=

# Which Claude model to use.
CLAUDE_MODEL=claude-sonnet-5

# Database location (SQLite by default). For a server, swap this for a
# Postgres URL like: postgresql+psycopg://user:pass@host:5432/forklifts
DATABASE_URL=sqlite:///./data/forklifts.db

# ===========================================================================
# ACCESS CONTROL (employee-only sign-in)  — see DEPLOY.md for full setup
# ===========================================================================

# Public domain the app is served at (used by Caddy for HTTPS). Example:
APP_DOMAIN=forklifts.yourcompany.com

# Long random string that signs login cookies. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Set to true in production (cookies only sent over HTTPS). Leave false locally.
SESSION_HTTPS_ONLY=true

# Shared review password (view-only access). Set this for a preview/demo so a
# reviewer can sign in with one password — no Google/Microsoft needed. Blank = off.
ACCESS_PASSWORD=

# Only emails at this domain may sign in. Blank = allow any (NOT recommended).
ALLOWED_EMAIL_DOMAIN=yourcompany.com
# Comma-separated emails that become admins on first login (everyone else = viewer).
ADMIN_EMAILS=you@yourcompany.com

# Local testing bypass — leave BLANK/false in production. When true, a
# /dev-login route lets you sign in without real OAuth.
DEV_LOGIN=false

# ---- Google sign-in (Google Cloud Console -> OAuth client) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft sign-in (Azure AD -> App registration) ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Your Microsoft tenant ID, or "organizations" to allow any work/school account.
MICROSOFT_TENANT=common
